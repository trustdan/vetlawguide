{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://va-law-planning.local/schemas/cfr-version.schema.json",
  "title": "Historical 38 C.F.R. Temporal Version Record",
  "description": "Schema enforcing strict separation of Federal Register publication dates, effective dates, applicability transition rules, and verbatim CFR snapshots.",
  "type": "object",
  "required": [
    "version_id",
    "cfr_section",
    "regulatory_status",
    "effective_from",
    "effective_to",
    "verbatim_text_status"
  ],
  "properties": {
    "version_id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "cfr_section": {
      "type": "string",
      "description": "Citation (e.g., '38 C.F.R. § 4.56' or 'former 38 C.F.R. § 4.132')."
    },
    "heading": {
      "type": "string",
      "description": "Exact section heading in that CFR edition."
    },
    "regulatory_status": {
      "type": "string",
      "enum": [
        "proposed-nonbinding",
        "interim-final-rescinded",
        "final-effective",
        "repealed-historical"
      ]
    },
    "federal_register_citation": {
      "type": ["string", "null"],
      "description": "Volume, page, and publication date (e.g., '62 Fed. Reg. 30,235 (June 3, 1997)')."
    },
    "publication_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_to": {
      "type": ["string", "null"],
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|present)$"
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "superseded_by": {
      "type": ["string", "null"]
    },
    "applicability_and_transition_notes": {
      "type": "string",
      "description": "Pending-claim Karnas rules or explicit non-retroactivity clauses (e.g., 77 FR 2909 scar applicability)."
    },
    "verbatim_text_status": {
      "type": "string",
      "enum": [
        "verbatim-govinfo-ecfr",
        "verbatim-federal-register",
        "summary-only-pull-print-cfr-before-cue"
      ]
    }
  }
}
