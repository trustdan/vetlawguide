# ==============================================================================
# VetLawGuide — Environment Variables Template (.env.example)
# Copy to `.env.local` for local development (`cp .env.example .env.local`).
# Never commit real API keys or secrets; `.env` and `.env*.local` are gitignored.
# ==============================================================================

# 1. Grounded Corpus Research Chat (`/api/chat` — ADR-0003)
# Required for live chat answers. Must be a paid commercial OpenAI API key
# (zero-training data policy). Leave unset to return a safe 503 fallback.
OPENAI_API_KEY=

# Optional model override (defaults to `gpt-5-nano` server-side).
CHAT_MODEL=gpt-5-nano

# 2. Supabase Conversation Analytics (`lib/chat/log-conversation.ts` — Optional)
# Run `supabase/migrations/0001_chat_conversations.sql` once in Supabase SQL Editor.
# Uses the server-only `service_role` key because `public.chat_conversations` is
# locked down with Row Level Security (`anon`/`authenticated` revoked).
# Safely no-ops when left blank.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Consent-Gated Public Analytics (`GTM-W9T68MCQ` + GA4 Measurement Protocol — Optional)
# Public pages load Google Tag ONLY after visitor opt-in (`vlg_consent`);
# `/investigate` unconditionally disables all analytics and third-party scripts.
NEXT_PUBLIC_GTM_ID=GTM-W9T68MCQ

# Optional server-side GA4 Measurement Protocol credentials for consent-gated
# `chat_message` event attribution (`lib/analytics/measurement-protocol.ts`).
GA_MEASUREMENT_ID=
GA_API_SECRET=
